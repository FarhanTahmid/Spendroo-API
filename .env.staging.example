# Staging on this machine (docs/staging-local.md). Copy to .env.staging and fill in.
# Never commit .env.staging.

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# The tunnel hostname is added automatically (STAGING_TUNNEL); these cover local checks
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Verification and reset codes are emailed: use a real SMTP account
# (e.g. Brevo's free tier, or a Gmail address with an app password)
# The sender must be verified with the SMTP provider (a spendroo.com address once the domain is verified there)
DEFAULT_FROM_EMAIL=Spendroo Staging <no-reply@spendroo.com>
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Google sign-in client IDs (optional). WEB_ is the one the app's tokens are made for
ANDROID_OAUTH2_CLIENT_ID=
WEB_OAUTH2_CLIENT_ID=1035441867051-1a5eg1m8k35urm125otb74d3skn0219b.apps.googleusercontent.com

# ---- Only for the no-Docker mode (staging-up.ps1 -Mode venv) ----
# A database and a role that is NOT a superuser (row-level security must apply)
PROD_DATABASE_HOST=localhost
PROD_DATABASE_PORT=5432
PROD_DATABASE_NAME=spendroo_staging
PROD_DATABASE_USER=spendroo_staging
PROD_DATABASE_PASSWORD=

# Push notifications. Path of the Firebase service-account key (a JSON file kept outside the
# repository): Firebase console > Project settings > Service accounts > Generate new private key.
# Empty = nothing is pushed.
FCM_CREDENTIALS_FILE=
