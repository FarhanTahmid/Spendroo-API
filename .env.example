# Copy to .env and fill in. Never commit .env.

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# 'development', 'production', 'test'
PROJECT_ENVIRONMENT='development'

# Database. Use the DEV_, TEST_ or PROD_ prefix that matches PROJECT_ENVIRONMENT.
# The role must not be a PostgreSQL superuser in production: superusers skip row-level security.
DEV_DATABASE_HOST='localhost'
DEV_DATABASE_PORT='5432'
DEV_DATABASE_NAME='spendroo_dev'
DEV_DATABASE_USER=
DEV_DATABASE_PASSWORD=

# Google sign-in: the OAuth client IDs whose ID tokens the API accepts (all empty = Google sign-in off).
# The app asks Google for a token made for the WEB client, on Android and iOS alike, so
# WEB_OAUTH2_CLIENT_ID is the one that must be set; it is the app's GOOGLE_SERVER_CLIENT_ID.
ANDROID_OAUTH2_CLIENT_ID=
IOS_OAUTH2_CLIENT_ID=
WEB_OAUTH2_CLIENT_ID=

# ---- Production only ----
# ALLOWED_HOSTS=api.spendroo.com
# CSRF_TRUSTED_ORIGINS=https://api.spendroo.com
# ADMIN_URL=some-unguessable-path/
# Number of reverse proxies you run in front of the app (0 = ignore X-Forwarded-For)
# TRUSTED_PROXY_COUNT=1
# Encryption keys for stored secrets, newest first:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEYS=
# DEFAULT_FROM_EMAIL=Spendroo <no-reply@spendroo.com>
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Push notifications. Path of the Firebase service-account key (a JSON file kept outside the
# repository): Firebase console > Project settings > Service accounts > Generate new private key.
# Empty = nothing is pushed.
FCM_CREDENTIALS_FILE=
